﻿{
  "Logging": {
    "IncludeScopes": false,
    "LogLevel": {
      "Default": "Debug",
      "System": "Information",
      "Microsoft": "Information"
    }
  },
  "Authentication": {
    "Ldap": {
      "Enabled": true,
      "Server": "192.168.100.168",
      "Port": 389,
      "BaseDn": "dc=M2LDAP",
      "UserSearchBase": "cn=users,dc=M2LDAP",
      "UserSearchFilter": "(&(objectClass=inetOrgPerson)(uid=%s))",
      "BindDn": "uid=admin,cn=users,dc=M2LDAP",
      "BindPassword": "change-me",
      "UseSsl": false,
      "AllowedGroups": []
    }
  }
}
