@page
@using BaGetter.Core.Configuration
@using BaGetter.Core.Feeds
@using BaGetter.Web.Extensions
@using Microsoft.Extensions.Options
@model IndexModel
@inject IOptions<NugetAuthenticationOptions> AuthOptions
@inject IFeedContext FeedContext

@{
    ViewData["Title"] = "Packages \u2014 " + FeedContext.CurrentFeed.Name;
    ViewData["SearchQuery"] = Model.Query;
    var requiresAuth = AuthOptions.Value.Mode != AuthenticationMode.Config;
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
}

@if (requiresAuth && !isAuthenticated)
{
    <div class="text-center" style="margin-top: 60px;">
        <h2>Sign in required</h2>
        <p>You need to sign in to browse packages.</p>
        <a asp-page="/Login" class="btn btn-primary">Sign in</a>
    </div>
    return;
}

@if (Model.HasNoAccessibleFeeds)
{
    <div class="text-center" style="margin-top: 60px;">
        <h2>No feeds available</h2>
        <p>You don't currently have access to any feeds. Please contact an administrator to be granted permissions.</p>
    </div>
    return;
}

@section SearchForm
{
    @* The search query is in a form in the header. The search filters are bindings on this Razor page.
    @* Pass the Razor bindings back up to the header's search form. *@
    @if (Model.PackageType != "any")
    {
        <input type="hidden" name="packageType" value="@Model.PackageType" />
    }

    @if (Model.Framework != "any")
    {
        <input type="hidden" name="framework" value="@Model.Framework" />
    }

    @if (Model.Tag != "any")
    {
        <input type="hidden" name="tag" value="@Model.Tag" />
    }

    @if (Model.Prerelease != true)
    {
        <input type="hidden" name="prerelease" value="False" />
    }
}

@if (FeedContext.CurrentFeed != null)
{
    <h1 class="feed-title">@FeedContext.CurrentFeed.Name</h1>
}

<div class="search-options form-inline">
    <div class="form-group">
        <label>Package type:</label>

        <div class="search-dropdown">
            <div class="dropdown">
                <button class="btn btn-default dropdown-toggle" type="button" id="package-type" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
                    @PackageTypeLabel(Model.PackageType)
                    <span class="caret"></span>
                </button>
                <ul class="dropdown-menu" aria-labelledby="package-type">
                    <li><a href="@SearchLink(packageType: "any", page: 1)">Any</a></li>
                    @foreach (var packageType in Model.PackageTypeFacets)
                    {
                        <li><a href="@SearchLink(packageType: packageType, page: 1)">@PackageTypeLabel(packageType)</a></li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <div class="form-group">
        <label>Framework:</label>

        <div class="search-dropdown">
            <div class="dropdown">
                <button class="btn btn-default dropdown-toggle" type="button" id="framework" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
                    @FrameworkLabel(Model.Framework)
                    <span class="caret"></span>
                </button>
                <ul class="dropdown-menu" aria-labelledby="framework">
                    <li><a href="@SearchLink(framework: "any", page: 1)">Any</a></li>
                    @foreach (var framework in Model.FrameworkFacets)
                    {
                        <li><a href="@SearchLink(framework: framework, page: 1)">@FrameworkLabel(framework)</a></li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <div class="form-group">
        <label>Tag:</label>

        <div class="search-dropdown">
            <div class="dropdown">
                <button class="btn btn-default dropdown-toggle" type="button" id="tag" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
                    @(Model.Tag == "any" ? "Any" : Model.Tag)
                    <span class="caret"></span>
                </button>
                <ul class="dropdown-menu tag-dropdown-menu" aria-labelledby="tag">
                    <li class="tag-search">
                        <input type="text" class="form-control input-sm" placeholder="Filter tags..."
                               autocomplete="off" oninput="window.baget.filterTags(this)" onclick="event.stopPropagation()" />
                    </li>
                    <li><a href="@SearchLink(tag: "any", page: 1)">Any</a></li>
                    @foreach (var tag in Model.TagFacets)
                    {
                        <li data-tag="@tag"><a href="@SearchLink(tag: tag, page: 1)">@tag</a></li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <div class="form-group form-check">
        <label for="prerelease">Include prerelease:</label>

        <input
            type="checkbox"
            id="prerelease"
            @(Model.Prerelease ? "checked='checked'" : "")
            onclick="window.location.href='@SearchLink(prerelease: !Model.Prerelease, page: 1)'" />
    </div>
</div>

@if (Model.Packages.Count == 0)
{
    <div>
        <h2>Oops, nothing here...</h2>
        <p>
            It looks like there's no package here to see. Take a look below for useful links.
        </p>
        <p><a asp-page="/Upload">Upload a package</a></p>
        <p><a href="https://www.bagetter.com/docs" target="_blank" rel="noopener noreferrer">BaGetter documentation</a></p>
        <p><a href="https://github.com/bagetter/BaGetter/issues" target="_blank" rel="noopener noreferrer">BaGetter issues</a></p>
    </div>
}
else
{
    @foreach (var package in Model.Packages)
    {
        <div class="row search-result">
            <div class="col-sm-1 hidden-xs hidden-sm">
                <img src="@package.IconUrl"
                     class="package-icon img-responsive"
                     onerror="this.src='@Url.Content("~/_content/BaGetter.Web/images/default-package-icon-256x256.png")'"
                     alt="The package icon" />
            </div>
            <div class="col-sm-11">
                <div>
                    <a asp-page="Package"
                       asp-route-id="@package.PackageId"
                       asp-route-version="@package.Version"
                       class="package-title">
                        @package.PackageId
                    </a>
                    <span>by: @string.Join(", ", package.Authors)</span>
                </div>
                <ul class="info">
                    <li>
                        <span>
                            <i class="ms-Icon ms-Icon--Download"></i>
                            @package.TotalDownloads.ToMetric() total downloads
                        </span>
                    </li>
                    <li>
                        <span>
                            <i class="ms-Icon ms-Icon--Flag"></i>
                            Latest version:
                            @if (package.Listed == false)
                            {
                                <span class="unlisted-version" title="This package is unlisted">@package.Version</span>
                                <span class="unlisted-label">(unlisted)</span>
                            }
                            else
                            {
                                @package.Version
                            }
                        </span>
                    </li>
                    @if (package.Tags.Any())
                    {
                        <li>
                            <span class="tags">
                                <i class="ms-Icon ms-Icon--Tag"></i>
                                @string.Join(" ", package.Tags)
                            </span>
                        </li>
                    }
                </ul>
                <div>
                    @package.Description
                </div>
            </div>
        </div>
    }

    var showPreviousLink = Model.PageIndex > 1;
    var showNextLink = Model.Packages.Count >= IndexModel.ResultsPerPage;

    if (showPreviousLink || showNextLink)
    {
        <nav aria-label="Search page navigation">
            <ul class="pager">
                @if (showPreviousLink)
                {
                    <li><a href="@SearchLink(page:Model.PageIndex - 1)">Previous</a></li>
                }

                @if (showNextLink)
                {
                    <li><a href="@SearchLink(page: Model.PageIndex + 1)">Next</a></li>
                }
            </ul>
        </nav>
    }
}

@functions {

    // Display-name lookups only. The set of options shown comes from the feed's facets
    // (Model.PackageTypeFacets / Model.FrameworkFacets); unknown values fall back to their raw value.
    private static readonly IReadOnlyDictionary<string, string> _packageTypeNames = new Dictionary<string, string>()
    {
        { "dependency", "Dependency" },
        { "dotnettool", ".NET tool" },
        { "dotnettemplate", ".NET template" },
    };

    private static readonly IReadOnlyDictionary<string, string> _frameworkNames = new Dictionary<string, string>()
    {
        { "net10.0", ".NET 10.0" },
        { "net9.0", ".NET 9.0" },
        { "net8.0", ".NET 8.0" },
        { "net7.0", ".NET 7.0" },
        { "net6.0", ".NET 6.0" },
        { "net5.0", ".NET 5.0" },

        { "netstandard2.1", ".NET Standard 2.1" },
        { "netstandard2.0", ".NET Standard 2.0" },
        { "netstandard1.6", ".NET Standard 1.6" },
        { "netstandard1.5", ".NET Standard 1.5" },
        { "netstandard1.4", ".NET Standard 1.4" },
        { "netstandard1.3", ".NET Standard 1.3" },
        { "netstandard1.2", ".NET Standard 1.2" },
        { "netstandard1.1", ".NET Standard 1.1" },
        { "netstandard1.0", ".NET Standard 1.0" },

        { "netcoreapp3.1", ".NET Core 3.1" },
        { "netcoreapp3.0", ".NET Core 3.0" },
        { "netcoreapp2.2", ".NET Core 2.2" },
        { "netcoreapp2.1", ".NET Core 2.1" },
        { "netcoreapp1.1", ".NET Core 1.1" },
        { "netcoreapp1.0", ".NET Core 1.0" },

        { "net481", ".NET Framework 4.8.1" },
        { "net48", ".NET Framework 4.8" },
        { "net472", ".NET Framework 4.7.2" },
        { "net471", ".NET Framework 4.7.1" },
        { "net463", ".NET Framework 4.6.3" },
        { "net462", ".NET Framework 4.6.2" },
        { "net461", ".NET Framework 4.6.1" },
        { "net46", ".NET Framework 4.6" },
        { "net452", ".NET Framework 4.5.2" },
        { "net451", ".NET Framework 4.5.1" },
        { "net45", ".NET Framework 4.5" },
        { "net403", ".NET Framework 4.0.3" },
        { "net4", ".NET Framework 4" },
        { "net35", ".NET Framework 3.5" },
        { "net2", ".NET Framework 2" },
        { "net11", ".NET Framework 1.1" },
    };

    private string PackageTypeLabel(string packageType)
    {
        if (string.IsNullOrEmpty(packageType) || packageType == "any") return "Any";
        return _packageTypeNames.GetValueOrDefault(packageType, packageType);
    }

    private string FrameworkLabel(string framework)
    {
        if (string.IsNullOrEmpty(framework) || framework == "any") return "Any";
        return _frameworkNames.GetValueOrDefault(framework, framework);
    }

    private string SearchLink(
        string packageType = null,
        string framework = null,
        string tag = null,
        bool? prerelease = null,
        int? page = null)
    {
        // Use model's value if the argument was skipped.
        packageType ??= Model.PackageType;
        framework ??= Model.Framework;
        tag ??= Model.Tag;
        prerelease ??= Model.Prerelease;
        page ??= Model.PageIndex;

        // Remove query parameters that have default value
        if (packageType == "any") packageType = null;
        if (framework == "any") framework = null;
        if (tag == "any") tag = null;
        if (prerelease == true) prerelease = null;
        if (page == 1) page = null;

        return Url.Page("Index", new
        {
            q = Model.Query,
            p = page,
            packageType,
            framework,
            tag,
            prerelease,
        });
    }
}
